          ],
          "lines": [
            {
              "speaker": "자르갈",
              "text": "왕루 씨는 무엇을 배웁니까?",
              "emphasized": [
                "배웁니까"
              ]
            },
            {
              "speaker": "왕루",
              "text": "한국어를 배웁니다.",
              "emphasized": [
                "를",
                "배웁니다"
              ]
            },
            {
              "speaker": "자르갈",
              "text": "한국어만 배웁니까?",
              "emphasized": [
                "만",
                "배웁니까"
              ]
            },
            {
              "speaker": "왕루",
              "text": "아니요, 영어도 배웁니다. 자르갈 씨도 한국어를 배웁니까?",
              "emphasized": [
                "도 배웁니다",
                "를 배웁니까"
              ]
            },
            {
              "speaker": "자르갈",
              "text": "네, 저도 한국어를 배웁니다.",
              "emphasized": [
                "를 배웁니다"
              ]
            },
            {
              "speaker": "왕루",
              "text": "한국어가 어떻습니까?",
              "emphasized": [
                "어떻습니까"
              ]
            },
            {
              "speaker": "자르갈",
              "text": "한국어가 재미있습니다.",
              "emphasized": [
                "재미있습니다"
              ]
            }
          ]
        },
        {
          "id": "hint-junbihagi1-expr",
          "toc_section": "준비하기 1",
          "type": "hint",
          "hint_kind": "expression",
          "related_text_ref": "text-school-life-dialogue",
          "items": [
            {
              "kind": "pattern",
              "text": "N이/가 어떻습니까?",
              "translation_ru": "Как N? — шаблон; пример «한국어가 어떻습니까?» = «Как вам корейский язык?»"
            }
          ]
        }
      ]
    },
    {
      "page_number": 43,
      "page_role": "content",
      "source_photo": "IMG_0979",
      "blocks": [
        {
          "id": "grammar-1",
          "toc_section": "준비하기 1",
          "type": "grammar_point",
          "pattern": "V-(스)ㅂ니다 / (스)ㅂ니까?",
          "section": "1",
          "explanation": "Формальный стиль настоящего времени — используется в новостях, презентациях, с начальством.",
          "examples": [
            "1) 가: 무엇을 봅니까?\n나: 한국어 책을 봅니다.",
            "2) 가: 한국어 책이 어떻습니까?\n나: 한국어 책이 재미있습니다."
          ],
          "rules": [
            "основа без받침 → -ㅂ니다 / -ㅂ니까?",
            "основа с받침 → -습니다 / -습니까?",
            "-ㅂ니다 — утверждение, -ㅂ니까? — вопрос"
          ]
        },
        {
          "id": "grammar-2",
          "toc_section": "준비하기 1",
          "type": "grammar_point",
          "pattern": "N을/를",
          "section": "2",
          "explanation": "Показывает прямое дополнение — предмет, над которым выполняется действие.",
          "examples": [
            "1) 가: 무엇을 먹습니까?\n나: 밥을 먹습니다.",
            "2) 가: 무엇을 합니까?\n나: 한국어를 배웁니다."
          ],
          "rules": [
            "N 받침 есть → N을",
            "N 받침 нет → N를",
            "무엇을 = 뭘 = 뭐"
          ]
        },
        {
          "id": "grammar-3",
          "toc_section": "준비하기 1",
          "type": "grammar_point",
          "pattern": "N만",
          "section": "3",
          "explanation": "Ограничивает — «только это и ничего больше».",
          "examples": [
            "1) 가: 가방에 무엇이 있습니까?\n나: 가방에 책만 있습니다.",
            "2) 가: 한국어만 공부합니까?\n나: 아니요, 중국어도 공부합니다."
          ],
          "rules": [
            "N만 ставится сразу после слова, которое получает значение «только» — одна форма (받침 роли не играет)",
            "заменяет частицы 은/는, 이/가, 을/를"
          ]
        }
      ]
    },
