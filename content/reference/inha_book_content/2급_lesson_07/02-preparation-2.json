          "lines": [
            {
              "speaker": "파하드",
              "text": "며칠 전에 여기에서 신발을 샀는데 교환할 수 있어요?"
            },
            {
              "speaker": "점원",
              "text": "신발 사이즈가 안 맞습니까?"
            },
            {
              "speaker": "파하드",
              "text": "네, 신어 보니까 사이즈가 좀 작아 가지고 교환하려고요.",
              "emphasized": [
                "보니까",
                "아 가지고"
              ]
            },
            {
              "speaker": "점원",
              "text": "교환을 할 때 영수증이 필요한데 가지고 오셨습니까?"
            },
            {
              "speaker": "파하드",
              "text": "가지고 왔어요. 여기요."
            },
            {
              "speaker": "점원",
              "text": "확인이 필요하니까 잠시만 기다려 주세요. 어떤 신발로 교환해 드릴까요?"
            },
            {
              "speaker": "파하드",
              "text": "좀 큰 사이즈로 바꿔 주세요."
            },
            {
              "speaker": "점원",
              "text": "색깔은 괜찮으세요?"
            },
            {
              "speaker": "파하드",
              "text": "하늘색 대신에 흰색으로 바꿔 주세요.",
              "emphasized": [
                "대신에"
              ]
            },
            {
              "speaker": "점원",
              "text": "잠시만 기다려 주세요."
            }
          ]
        }
      ]
    },
