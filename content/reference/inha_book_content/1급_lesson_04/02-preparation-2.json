          ],
          "lines": [
            {
              "speaker": "파하드",
              "text": "아멜리 씨, 토요일에 무엇을 합니까?",
              "emphasized": [
                "에"
              ]
            },
            {
              "speaker": "아멜리",
              "text": "저는 토요일에 수영을 배웁니다.",
              "emphasized": [
                "에"
              ]
            },
            {
              "speaker": "파하드",
              "text": "일요일에도 수영을 배웁니까?",
              "emphasized": [
                "에도"
              ]
            },
            {
              "speaker": "아멜리",
              "text": "아니요, 일요일에는 집에서 쉽니다. 파하드 씨는 토요일에 무엇을 합니까?",
              "emphasized": [
                "에는",
                "에"
              ]
            },
            {
              "speaker": "파하드",
              "text": "저는 토요일마다 공원에 갑니다. 공원에서 운동을 합니다.",
              "emphasized": [
                "마다"
              ]
            },
            {
              "speaker": "아멜리",
              "text": "무슨 운동을 합니까?"
            },
            {
              "speaker": "파하드",
              "text": "저는 공원에서 친구와 같이 야구를 합니다.",
              "emphasized": [
                "와 같이"
              ]
            }
          ]
        },
        {
          "type": "hint",
          "id": "hint-junbihagi2-expr",
          "toc_section": "준비하기 2",
          "hint_kind": "expression",
          "related_text_ref": "text-calendar-dialogue",
          "items": [
            {
              "kind": "pattern",
              "text": "N마다",
              "translation_ru": "каждый N — шаблон; «토요일마다» = «каждую субботу»"
            },
            {
              "kind": "pattern",
              "text": "N와/과 같이(함께), N하고 같이(함께)",
