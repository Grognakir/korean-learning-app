      "blocks": [
        {
          "id": "grammar-1",
          "toc_section": "준비하기 1",
          "type": "grammar_point",
          "pattern": "N과/와 N, N하고 N",
          "section": "1",
          "explanation": "Соединяет два существительных в значении «и». 과/와 — более формальный, письменный вариант, 하고 — разговорный.",
          "examples": [
            "1) 가: 책상에 무엇이 있습니까?\n나: 책상에 책과 연필이 있습니다.",
            "2) 가: 방에 무엇이 있습니까?\n나: 제 방에 침대와 책상이 있습니다.",
            "3) 가: 집에서 무엇을 합니까?\n나: 저는 집에서 한국어하고 영어를 공부합니다."
          ],
          "rules": [
            "N 받침 есть → N과 N",
            "N 받침 нет → N와 N",
            "N하고 N — одна форма, 받침 роли не играет"
          ]
        },
        {
          "id": "grammar-2",
          "toc_section": "준비하기 1",
          "type": "grammar_point",
          "pattern": "N에서",
          "section": "2",
          "explanation": "Показывает место, где происходит действие (в отличие от 에, которое про статичное нахождение).",
          "examples": [
            "1) 가: 도서관에서 무엇을 합니까?\n나: 저는 도서관에서 공부를 합니다.",
            "2) 가: 학교에서 무엇을 배웁니까?\n나: 학교에서 한국어를 배웁니다."
          ],
          "rules": [
            "N에서 ставится после существительного места — одна форма (받침 роли не играет)",
            "학교에 있습니다 (нахожусь в школе, статика) ≠ 학교에서 공부합니다 (учусь в школе, действие)"
          ]
        }
      ]
    },
