          "lines": [
            {
              "speaker": "왕루",
              "text": "자르갈 씨, 안녕하세요?"
            },
            {
              "speaker": "자르갈",
              "text": "네, 왕루 씨, 안녕하세요? 어디에 갑니까?"
            },
            {
              "speaker": "왕루",
              "text": "저는 도서관에 갑니다."
            },
            {
              "speaker": "자르갈",
              "text": "왕루 씨는 도서관에서 무엇을 합니까?",
              "emphasized": [
                "에서"
              ]
            },
            {
              "speaker": "왕루",
              "text": "저는 도서관에서 숙제를 합니다. 자르갈 씨는 어디에 갑니까?",
              "emphasized": [
                "에서"
              ]
            },
            {
              "speaker": "자르갈",
              "text": "저는 운동장에 갑니다. 운동장에서 축구하고 농구를 합니다.",
              "emphasized": [
                "에서",
                "하고"
              ]
            }
          ]
        },
