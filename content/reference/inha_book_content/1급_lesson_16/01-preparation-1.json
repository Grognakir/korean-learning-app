          "lines": [
            {
              "speaker": "파하드",
              "text": "아멜리 씨, 이게 누구의 사진이에요?"
            },
            {
              "speaker": "아멜리",
              "text": "제 가족사진이에요."
            },
            {
              "speaker": "파하드",
              "text": "아, 아멜리 씨의 가족이 모두 4명이에요?"
            },
            {
              "speaker": "아멜리",
              "text": "네, 아버지, 어머니, 언니 그리고 저예요."
            },
            {
              "speaker": "파하드",
              "text": "모두 고향에서 살아요?"
            },
            {
              "speaker": "아멜리",
              "text": "아니요, 부모님께서는 프랑스에 계시는데 언니는 중국에 있어요. 중국의 무역 회사에서 일을 하고 있어요.",
              "emphasized": [
                "계시는데",
                "무역 회사"
              ]
            },
            {
              "speaker": "파하드",
              "text": "가족들이 많이 그립겠어요. 곧 방학인데 고향에 안 가요?",
              "emphasized": [
                "그립겠어요",
                "방학인데"
              ]
            },
            {
              "speaker": "아멜리",
              "text": "방학에 어머니 생신이 있어서 고향에 다녀오려고 해요.",
              "emphasized": [
                "다녀오려고"
              ]
            },
            {
              "speaker": "파하드",
              "text": "와, 정말 좋겠어요."
            },
            {
              "speaker": "아멜리",
              "text": "네, 저도 기대하고 있어요.",
              "emphasized": [
                "기대하고"
              ]
            }
          ]
        }
      ]
    },
