      "blocks": [
        {
          "type": "grammar_point",
          "id": "grammar-1",
          "toc_section": "준비하기 1",
          "pattern": "AV-(으)ㄴ/는/(으)ㄹ N, N인 N",
          "section": "1",
          "explanation": "**Смысл:** форма глагола перед существительным — «N, который делает, делал, будет делать». Меняется по времени.",
          "examples": [
            "1) 저기에서 사진을 찍는 사람이 누구예요?",
            "2) 지난번에 산 바지가 조금 작아서 바꾸려고 해요.",
            "3) 방학 동안 여행할 장소를 생각해 보세요.",
            "4) 요즘 읽고 있는 소설책이 아주 재미있어요.",
            "5) 제 친구인 오위노 씨는 대학원생입니다."
          ],
          "rules_table": {
            "head": [
              "Часть речи",
              "Окончание",
              "Пример"
            ],
            "rows": [
              [
                "AV — настоящее",
                "-는 N",
                "읽다 → 읽는 책, 만들다 → 만드는 책"
              ],
              [
                "있다/없다",
                "-는 N",
                "있다 → 있는 사람"
              ],
              [
                "AV — прошедшее, нет 받침",
                "-ㄴ N",
                "사다 → 산 가방"
              ],
              [
                "AV — прошедшее, есть 받침",
                "-은 N",
                "먹다 → 먹은 음식"
              ],
              [
                "AV — будущее, предположение, нет 받침",
                "-ㄹ N",
                "여행하다 → 여행할 곳"
              ],
              [
                "AV — будущее, предположение, есть 받침",
                "-을 N",
                "먹다 → 먹을 음식"
              ],
              [
                "받침 ㄹ",
                "ㄹ выпадает в -는 и -ㄴ, в -ㄹ остаётся",
                "살다 → 사는 사람, 산 집, 살 집"
              ],
              [
                "N",
                "인 N",
                "학생 → 학생인 친구"
              ]
            ]
          }
        },
        {
          "type": "grammar_point",
          "id": "grammar-2",
          "toc_section": "준비하기 1",
          "pattern": "V-(으)ㄴ/는데, N인데",
          "section": "2",
          "explanation": "**Смысл:** конструкция, которую используют, когда вводят фон или мягко противопоставляют — «а …», «но …», «сейчас …, поэтому …».",
          "examples": [
            "1) 공원에서 사진을 찍는데 갑자기 비가 왔어요.",
            "2) 쇼핑하러 명동에 갈 건데 같이 갈까요?",
            "3) 주말인데 집에만 있지 말고 산책을 해 보세요.",
            "4) 형은 키가 큰데 동생은 키가 작아요.",
            "5) 어제는 너무 바빴는데 오늘은 할 일이 없어서 심심해요."
          ],
          "rules_table": {
            "head": [
              "Часть речи",
              "Окончание",
              "Пример"
            ],
            "rows": [
              [
                "V — настоящее",
                "-는데",
                "가다 → 가는데"
              ],
              [
                "있다/없다",
                "-는데",
                "맛있다 → 맛있는데"
              ],
              [
                "DV — нет 받침",
                "-ㄴ데",
                "예쁘다 → 예쁜데"
              ],
              [
                "DV — есть 받침",
                "-은데",
                "작다 → 작은데"
              ],
              [
                "받침 ㄹ",
                "ㄹ выпадает",
                "살다 → 사는데, 길다 → 긴데"
              ],
              [
                "Прошедшее время",
                "-았/었는데",
                "바빴는데"
              ],
              [
                "Будущее время и предположение",
                "-(으)ㄹ 건데",
                "갈 건데"
              ],
              [
                "N",
                "인데",
                "주말 → 주말인데"
              ]
            ]
          }
        }
      ]
