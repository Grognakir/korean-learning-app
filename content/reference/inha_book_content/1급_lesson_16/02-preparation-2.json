          ],
          "lines": [
            {
              "speaker": "자르갈",
              "text": "아멜리 씨, 곧 방학인데 뭐 할 거예요?",
              "emphasized": [
                "방학인데"
              ]
            },
            {
              "speaker": "아멜리",
              "text": "방학에 어머니 생신도 있고 부모님도 보고 싶어서 고향에 다녀오려고 해요.",
              "emphasized": [
                "다녀오려고"
              ]
            },
            {
              "speaker": "자르갈",
              "text": "아, 어머니께 드릴 생신 선물은 샀어요?",
              "emphasized": [
                "께",
                "드릴"
              ]
            },
            {
              "speaker": "아멜리",
              "text": "아니요, 아직 못 샀어요. 빨리 사야 하는데 고민이에요. 어머니께 무슨 선물을 드리면 좋아하실까요?",
              "emphasized": [
                "사야 하는데",
                "고민",
                "께",
                "드리면"
              ]
            },
            {
              "speaker": "자르갈",
              "text": "음……. 생신 선물을 사 드리는 것도 좋지만 생신날에 맛있는 한국 음식을 만들어 드리는 게 어때요? 그리고 어머니께 감사의 편지도 써 드리면 더 좋아하실 거예요.",
              "emphasized": [
                "사 드리는",
                "만들어 드리는 게 어때요",
                "써 드리면"
              ]
            },
            {
              "speaker": "아멜리",
              "text": "와! 정말 좋은 생각이에요. 자르갈 씨, 고마워요.",
              "emphasized": [
                "생각"
              ]
            }
          ]
        },
        {
          "type": "hint",
          "id": "hint-junbihagi2-expr",
