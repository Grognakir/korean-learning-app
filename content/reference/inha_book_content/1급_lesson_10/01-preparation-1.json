            "2) 가: 저녁에 냉면을 먹을까요?\n나: 네, 좋아요."
          ],
          "rules_table": {
            "head": [
              "Часть речи",
              "Окончание",
              "Пример"
            ],
            "rows": [
              [
                "Нет 받침",
                "-ㄹ까요?",
                "가다 → 갈까요?"
              ],
              [
                "Есть 받침",
                "-을까요?",
                "먹다 → 먹을까요?"
              ],
              [
                "받침 ㄹ",
                "-ㄹ까요?",
                "놀다 → 놀까요?"
              ],
              [
                "ㅂ 불규칙",
                "ㅂ → 우",
                "돕다 → 도울까요?"
