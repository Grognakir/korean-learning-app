                "-는 편이다",
                "맛있는 편이에요"
              ],
              [
                "Прошедшее время",
                "편이다 → 편이었다",
                "먹다 → 먹는 편이었어요, 비싸다 → 비싼 편이었어요"
              ],
              [
                "Предположение (с будущим не работает)",
                "-는 편일 거예요",
                "먹는 편일 거예요"
              ],
              [
                "DV — есть 받침",
                "-은 편이다",
                "많다 → 많은 편이에요"
              ],
              [
                "DV — нет 받침",
                "-ㄴ 편이다",
                "비싸다 → 비싼 편이에요"
              ],
              [
                "N",
                "인 편이다",
                "부자 → 부자인 편이에요"
              ],
              [
                "AV/DV — 받침 ㄹ",
