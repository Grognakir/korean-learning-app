          "lines": [
            {
              "speaker": "파하드",
              "text": "당근 한 개에 얼마예요?",
              "emphasized": [
                "한 개",
                "얼마예요"
              ]
            },
            {
              "speaker": "점원",
              "text": "오백 원입니다."
            },
            {
              "speaker": "파하드",
              "text": "싱싱해요?"
            },
            {
              "speaker": "점원",
              "text": "예, 싱싱하고 맛있습니다."
            },
            {
              "speaker": "파하드",
              "text": "감자는 얼마예요?"
            },
            {
              "speaker": "점원",
              "text": "세 개에 이천 원입니다.",
              "emphasized": [
                "세 개"
              ]
            },
            {
              "speaker": "파하드",
              "text": "조금 비싸요."
            },
            {
              "speaker": "점원",
              "text": "그러면 천 오백 원만 주십시오.",
              "emphasized": [
                "주십시오"
              ]
            },
            {
              "speaker": "파하드",
              "text": "고맙습니다. 그럼 당근 두 개와 감자 세 개 주세요.",
              "emphasized": [
                "두 개",
                "세 개",
                "주세요"
              ]
            },
            {
              "speaker": "점원",
              "text": "여기 있습니다. 모두 이천오백 원입니다."
            },
            {
              "speaker": "파하드",
              "text": "네, 감사합니다."
            }
          ]
        },
