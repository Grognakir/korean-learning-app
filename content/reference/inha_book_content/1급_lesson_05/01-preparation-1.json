            },
            {
              "speaker": "아멜리",
              "text": "저는 8시 30분에 와요.",
              "emphasized": [
                "에 와요"
              ]
            },
            {
              "speaker": "자르갈",
              "text": "한국어 수업은 몇 시에 끝나요?",
              "emphasized": [
                "끝나요"
              ]
            },
            {
              "speaker": "아멜리",
              "text": "1시에 끝나요.",
              "emphasized": [
                "끝나요"
              ]
            },
            {
              "speaker": "자르갈",
              "text": "그리고 무엇을 해요?",
              "emphasized": [
                "해요"
              ]
            },
            {
              "speaker": "아멜리",
              "text": "도서관에 가요. 그리고 숙제를 해요.",
              "emphasized": [
                "가요",
                "해요"
              ]
            },
            {
              "speaker": "자르갈",
              "text": "몇 시에 집에 가요?",
              "emphasized": [
                "가요"
              ]
            },
            {
              "speaker": "아멜리",
              "text": "오후 5시에 집에 가요.",
              "emphasized": [
                "가요"
              ]
            }
          ]
        }
      ]
