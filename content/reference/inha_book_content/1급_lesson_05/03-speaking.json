          "lines": [
            {
              "speaker": "흐엉",
              "text": "파하드 씨, 몇 시에 일어나요?",
              "emphasized": [
                "시에"
              ]
            },
            {
              "speaker": "파하드",
              "text": "저는 7시에 일어나요.",
              "emphasized": [
                "시에"
              ]
            },
            {
              "speaker": "흐엉",
              "text": "아침에 무엇을 해요?"
            },
            {
              "speaker": "파하드",
              "text": "저는 7시 반에 아침을 먹어요. 그리고 학교에 가요.",
              "emphasized": [
                "시 반에"
              ]
            },
            {
              "speaker": "흐엉",
              "text": "한국어 수업이 몇 시부터 몇 시까지 해요?",
              "emphasized": [
                "부터",
                "까지"
              ]
            },
            {
              "speaker": "파하드",
              "text": "한국어 수업은 9시부터 1시까지 해요.",
              "emphasized": [
                "부터",
                "까지"
              ]
            },
            {
              "speaker": "흐엉",
              "text": "언제 점심을 먹어요?"
            },
            {
              "speaker": "파하드",
              "text": "1시부터 2시까지 점심을 먹어요.",
              "emphasized": [
                "부터",
                "까지"
              ]
            },
            {
              "speaker": "흐엉",
              "text": "그리고 무엇을 해요?"
            },
            {
              "speaker": "파하드",
              "text": "2시부터 4시까지 운동장에서 운동을 해요. 그리고 4시부터 7시까지 도서관에서 공부해요.",
              "emphasized": [
                "부터",
                "까지"
              ]
            }
