                "-어도 되다",
                "먹다 → 먹어도 돼요"
              ],
              [
                "하다",
                "-해도 되다",
                "질문하다 → 질문해도 돼요"
              ],
              [
                "Мягче и вежливее",
                "-아/어도 좋다 / 괜찮다",
                "앉아도 괜찮아요, 앉아도 좋아요"
