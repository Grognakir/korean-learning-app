          "rules_table": {
            "head": [
              "Часть речи",
              "Окончание",
              "Пример"
            ],
            "rows": [
              [
                "ㅏ, ㅗ",
                "-아도 되다",
                "앉다 → 앉아도 돼요"
              ],
