          "lines": [
            {
              "speaker": "자르갈",
              "text": "흐엉 씨, 문학경기장에 야구를 보러 갈 건데 어떻게 가는지 알아요?"
            },
            {
              "speaker": "흐엉",
              "text": "문학경기장에 가려면 학교 정문 앞에서 버스를 타세요."
            },
            {
              "speaker": "자르갈",
              "text": "몇 번 버스를 타요?"
            },
            {
              "speaker": "흐엉",
              "text": "5번이나 111-2번 버스를 타고 가세요."
            },
            {
              "speaker": "자르갈",
              "text": "버스를 타고 가다가 어디에서 내려요?"
            },
            {
              "speaker": "흐엉",
              "text": "문학경기장 북문 정류장에서 내리세요."
            },
            {
              "speaker": "자르갈",
              "text": "북문 정류장 근처에 야구장이 있어요?"
            },
            {
              "speaker": "흐엉",
              "text": "네, 앞으로 500m쯤 가면 왼쪽에 야구장이 있어요."
            },
            {
              "speaker": "자르갈",
              "text": "그래요? 여기에서 몇 분쯤 걸릴까요?"
            },
            {
              "speaker": "흐엉",
              "text": "저도 얼마나 걸리는지 잘 모르겠는데 멀지는 않아요."
            },
            {
              "speaker": "자르갈",
              "text": "고마워요."
            },
            {
              "speaker": "흐엉",
              "text": "오늘 경기 잘 보고 오세요."
            }
          ]
        },
