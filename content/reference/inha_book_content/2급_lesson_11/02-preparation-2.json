          "lines": [
            {
              "speaker": "간호사",
              "text": "한마음 동물 병원입니다."
            },
            {
              "speaker": "아멜리",
              "text": "지금 병원에 가려고 하는데 어디에 있는지 잘 몰라서 여쭤 보려고요."
            },
            {
              "speaker": "간호사",
              "text": "지금 계시는 곳이 어디세요?"
            },
            {
              "speaker": "아멜리",
              "text": "인하로 30번 길에 있어요."
            },
            {
              "speaker": "간호사",
              "text": "인하로 30번 길에 계시면 꿈나무 유치원이 보여요?"
            },
            {
              "speaker": "아멜리",
              "text": "네, 유치원 앞에 서 있어요."
            },
            {
              "speaker": "간호사",
              "text": "유치원을 끼고 오른쪽으로 돌면 무지개 꽃집이 있을 겁니다."
            },
            {
              "speaker": "아멜리",
              "text": "네, 꽃집이 있어요."
            },
            {
              "speaker": "간호사",
              "text": "꽃집 앞에서 지하도를 건너세요. 그러면 소방서가 있습니다."
            },
            {
              "speaker": "아멜리",
              "text": "네, 소방서가 보여요."
            },
            {
              "speaker": "간호사",
              "text": "소방서에서 앞으로 쭉 오세요."
            },
            {
              "speaker": "아멜리",
              "text": "소방서에서 얼마만큼 가면 돼요?"
            },
            {
              "speaker": "간호사",
              "text": "약 50m쯤 오시면 병원이 있습니다."
            }
          ]
        },
