      "blocks": [
        {
          "id": "grammar-3",
          "toc_section": "준비하기 2",
          "type": "grammar_point",
          "pattern": "N에①",
          "section": "3",
          "explanation": "Показывает место, где что-то находится.",
          "examples": [
            "1) 가: 교실에 무엇이 있습니까?\n나: 교실에 책상이 있습니다.",
            "2) 가: 교실에 칠판이 있습니까?\n나: 네, 교실에 칠판이 있습니다."
          ],
          "rules": [
            "N에 ставится после слова-места: «в/на N»",
            "одна форма, 받침 роли не играет"
          ]
        },
        {
          "id": "grammar-4",
          "toc_section": "준비하기 2",
          "type": "grammar_point",
          "pattern": "N이/가 있다/없다",
          "section": "4",
          "explanation": "Есть / нет чего-либо; 있다 — «быть, находиться», 없다 — «не быть, отсутствовать».",
          "examples": [
            "1) 가: 방에 뭐가 있습니까?\n나: 방에 침대가 있습니다.",
            "2) 가: 방에 책상이 있습니까?\n나: 아니요, 방에 책상이 없습니다."
          ],
          "rules": [
            "N 받침 есть → N이 있다/없다",
            "N 받침 нет → N가 있다/없다",
            "무엇이 = 뭐가"
          ]
        }
      ]
    },
