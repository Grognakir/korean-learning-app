      "blocks": [
        {
          "id": "grammar-1",
          "toc_section": "준비하기 1",
          "type": "grammar_point",
          "pattern": "이 / 그 / 저",
          "section": "1",
          "explanation": "Указательные слова: 이 — предмет рядом с говорящим, 그 — рядом с собеседником (или уже упомянутый), 저 — далеко от обоих.",
          "examples": [
            "1) 가: 이것이 무엇입니까?\n나: 이것은 책입니다.",
            "2) 가: 그것이 무엇입니까?\n나: 이것은 휴대전화입니다.",
            "3) 가: 저것이 무엇입니까?\n나: 저것은 칠판입니다."
          ],
          "rules": [
            "이것이, 그것이, 저것이 = 이게, 그게, 저게",
            "이것은, 그것은, 저것은 = 이건, 그건, 저건",
            "이곳, 그곳, 저곳 = 여기, 거기, 저기"
          ]
        },
        {
          "id": "grammar-2",
          "toc_section": "준비하기 1",
          "type": "grammar_point",
          "pattern": "N의",
          "section": "2",
          "explanation": "Показывает принадлежность — «N-а, N-ов»; 누구의 — «чей».",
          "examples": [
            "1) 가: 그 책이 누구의 책입니까?\n나: 이 책은 제 것입니다.",
            "2) 가: 이 안경이 누구의 것입니까?\n나: 그 안경은 제 아버지의 것입니다.",
            "3) 가: 저 공책이 누구의 것입니까?\n나: 저 공책은 박지성 씨의 공책입니다."
          ],
          "rules": [
            "N의 + N: принадлежность («N-а, N-ов»)",
            "저의 → 제 / 나의 → 내 / 너의 → 네"
          ]
        }
      ]
    },
