          "pattern": "이 / 그 / 저",
          "section": "1",
          "explanation": "**Смысл:** слова, которые ставят перед существительным, чтобы указать на предмет по расстоянию, — «этот», «тот», «вон тот».",
          "examples": [
            "1) 가: 이것이 무엇입니까?\n나: 이것은 책입니다.",
            "2) 가: 그것이 무엇입니까?\n나: 이것은 휴대전화입니다.",
            "3) 가: 저것이 무엇입니까?\n나: 저것은 칠판입니다."
          ],
          "rules_table": {
            "head": [
              "",
              "이",
              "그",
              "저"
            ],
            "rows": [
              [
                "Предмет",
                "이것",
                "그것",
                "저것"
              ],
              [
                "Сокращение с 이/가",
                "이게",
                "그게",
                "저게"
              ],
              [
                "Сокращение с 은/는",
                "이건",
                "그건",
                "저건"
              ],
              [
                "Место",
                "여기 (이곳)",
                "거기 (그곳)",
                "저기 (저곳)"
              ]
            ]
          },
          "rules": [
            "이 — рядом с говорящим\n**이 책**",
            "그 — рядом с собеседником или уже упомянут\n**그 책**",
            "저 — далеко от обоих\n**저 책**"
          ]
        },
        {
          "type": "grammar_point",
          "id": "grammar-2",
          "toc_section": "준비하기 1",
          "pattern": "N의",
          "section": "2",
          "explanation": "**Смысл:** частица, которую используют, когда показывают принадлежность — «чей?»: «сумка друга», «имя сестры».",
          "examples": [
            "1) 가: 그 책이 누구의 책입니까?\n나: 이 책은 제 것입니다.",
            "2) 가: 이 안경이 누구의 것입니까?\n나: 그 안경은 제 아버지의 것입니다.",
            "3) 가: 저 공책이 누구의 것입니까?\n나: 저 공책은 박지성 씨의 공책입니다."
          ],
          "rules": [
            "받침 не важен → N의 + N\n**친구 → 친구의 가방**",
            "저의 → 제, 나의 → 내, 너의 → 네\n**제 가방**",
            "N의 것 — «принадлежит N»\n**아버지의 것**",
            "Работает со всеми временами (과거, 현재, 미래) и предположением"
          ]
        }
      ]
