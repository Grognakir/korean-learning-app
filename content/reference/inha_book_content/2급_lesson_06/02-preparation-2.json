          ],
          "lines": [
            {
              "speaker": "아저씨",
              "text": "네, 인하중국집입니다."
            },
            {
              "speaker": "흐엉",
              "text": "인하빌라 109동 503호인데요. 지금 짜장면 배달됩니까?"
            },
            {
              "speaker": "아저씨",
              "text": "네, 배달됩니다. 몇 그릇을 배달해 드릴까요?"
            },
            {
              "speaker": "흐엉",
              "text": "짜장면 일 인분하고 짬뽕 일 인분을 배달해 주세요."
            },
            {
              "speaker": "아저씨",
              "text": "네, 알겠습니다."
            },
            {
              "speaker": "흐엉",
              "text": "참, 탕수육도 하나 배달해 주세요. 몇 분 후에 도착해요?"
            },
            {
              "speaker": "아저씨",
              "text": "15분 후에 배달될 겁니다."
            },
            {
              "speaker": "",
              "text": "〈잠시 후〉"
            },
            {
              "speaker": "아저씨",
              "text": "식사 배달 왔습니다. 식사하시고 그릇은 문 앞에 놓아 두세요."
            },
            {
              "speaker": "흐엉",
              "text": "네, 알겠어요."
            }
          ]
        }
      ]
