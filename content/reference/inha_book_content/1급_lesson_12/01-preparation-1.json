          "toc_section": "준비하기 1",
          "pattern": "V-아/어/여서②, N이어/여서",
          "section": "1",
          "explanation": "**Смысл:** конструкция, которую используют, когда второе действие вытекает из первого и связано с ним — «пошёл и (там) …», «купил и …».",
          "examples": [
            "1) 한국어 시험에 합격해서 기분이 좋습니다.",
            "2) 주말에 날씨가 좋아서 공원에 자전거를 타러 갔어요.",
            "3) 겨울이어서 눈이 자주 옵니다. / 겨울이라서 눈이 자주 옵니다."
          ],
          "rules_table": {
            "head": [
              "Часть речи",
              "Окончание",
              "Пример"
            ],
            "rows": [
              [
                "Последняя гласная ㅏ/ㅗ",
                "-아서",
                "가다 → 가서, 앉다 → 앉아서"
              ],
              [
                "Остальные гласные",
                "-어서",
                "먹다 → 먹어서"
              ],
              [
                "하다",
                "-해서",
                "준비하다 → 준비해서"
              ]
            ]
          }
        },
        {
