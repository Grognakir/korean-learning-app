          "pattern": "V-아/어/여야 되다/하다",
          "section": "4",
          "explanation": "**Смысл:** конструкция, которую используют, когда говорят, что нужно или обязательно надо что-то сделать — «должен AV», «нужно AV».",
          "examples": [
            "1) 곧 영화가 시작하니까 자리에 앉아야 돼요.",
            "2) 감기에 걸렸으니까 약을 먹어야 해요.",
            "3) 신발은 가벼워야 됩니다.",
            "4) 약속 시간에 늦지 않아야 해요."
          ],
          "rules_table": {
            "head": [
              "Часть речи",
              "Окончание",
              "Пример"
            ],
            "rows": [
              [
                "ㅏ, ㅗ",
                "-아야 하다/되다",
                "앉다 → 앉아야 해요"
              ],
              [
                "Остальные гласные",
                "-어야 하다/되다",
                "먹다 → 먹어야 해요"
              ],
              [
                "하다",
                "-해야 하다/되다",
                "운동하다 → 운동해야 해요"
              ],
              [
                "ㅂ 불규칙",
                "ㅂ → 우",
                "가볍다 → 가벼워야 돼요"
              ],
              [
                "Прошедшее время",
                "-아/어야 했어요",
                "해야 했어요"
              ],
              [
                "Будущее время и предположение",
                "-아/어야 할 거예요",
                "해야 할 거예요"
              ],
              [
                "«Не должен»",
                "-지 않아야 하다",
                "늦지 않아야 해요"
              ],
              [
                "«Не обязательно»",
                "-지 않아도 되다 / 안 -아/어도 되다",
                "가지 않아도 돼요"
              ]
            ]
          }
        },
