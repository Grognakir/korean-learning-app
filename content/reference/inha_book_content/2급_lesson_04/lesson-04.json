          ]
        },
        {
          "id": "grammar-5",
          "toc_section": "준비하기 2",
          "type": "grammar_point",
          "pattern": "N(으)로③",
          "section": "5",
          "explanation": "Показывает результат изменения, обмена или замены — «во что» превратилось.",
