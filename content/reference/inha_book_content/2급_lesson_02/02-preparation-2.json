          "title": "집에 대한 정보를 묻기",
          "title_ru": "Спросить о жилье",
          "illustration": {
            "storage_path": "lesson_2/illustration_2_house_search.png",
            "original_kind": "illustration"
          },
          "text_kind": "dialogue",
          "section": "준비하기2",
          "exercise_ref": null,
