          ],
          "lines": [
            {
              "speaker": "아멜리",
              "text": "지성 씨, 제가 다음 달에 이사를 하게 됐어요.",
              "emphasized": [
                "이사를 하게 됐어요"
              ]
            },
            {
              "speaker": "박지성",
              "text": "그래요? 집을 구했어요?"
            },
            {
              "speaker": "아멜리",
              "text": "아직 못 구했어요. 그런데 전세와 월세의 차이가 뭐예요?"
            },
            {
              "speaker": "박지성",
              "text": "전세는 보증금이 많고 월세는 보증금이 적어요."
            },
            {
              "speaker": "아멜리",
              "text": "그럼 저는 월세가 더 좋아요."
            },
            {
              "speaker": "박지성",
              "text": "그런데 월세는 전세에 비해서 보증금이 적지만 매월 돈을 내야 해요.",
              "emphasized": [
                "전세에 비해서"
              ]
            },
            {
              "speaker": "아멜리",
              "text": "월세는 이사한 다음에 바로 돈을 내요?",
              "emphasized": [
                "이사한 다음에"
              ]
            },
            {
              "speaker": "박지성",
              "text": "아니요, 이사하고 한 달 후에 돈을 내요."
            },
            {
              "speaker": "아멜리",
              "text": "네, 가르쳐 줘서 고마워요."
            },
            {
              "speaker": "박지성",
              "text": "궁금하면 또 물어보세요."
            }
          ]
        }
      ]
