    {
      "page_number": 27,
      "page_role": "content",
      "source_photo": "photo_13",
      "blocks": [
        {
          "id": "grammar-1",
          "toc_section": "준비하기 1",
          "type": "grammar_point",
          "pattern": "AV-는 중이다, N 중이다",
          "section": "1",
          "explanation": "Подчёркивает, что действие происходит прямо сейчас, в процессе — близко к -고 있다, но чуть более книжно, с оттенком «занят этим».",
          "examples": [
            "가: 뭐 하는 중이에요?\n나: 친구와 식당에서 밥을 먹는 중이에요.",
            "가: 언제 비가 왔어요?\n나: 학교에 가는 중에 비가 왔어요.",
            "수업 중에 휴대전화를 사용하지 마세요."
          ],
          "rules": [
            "глагол + 는 중이다 (받침 роли не играет): 먹다 → 먹는 중이다",
            "N + 중이다: 회의 중이다, 식사 중이다"
          ]
        },
        {
          "id": "grammar-2",
          "toc_section": "준비하기 1",
          "type": "grammar_point",
          "pattern": "V-(으)ㄹ 때, N 때",
          "section": "2",
          "explanation": "Обозначает момент или период, когда что-то происходит.",
          "examples": [
            "가: 언제 텔레비전을 봐요?\n나: 저녁을 먹을 때 텔레비전을 봐요.",
            "바쁠 때 제가 도와 드릴게요.",
            "어제 도서관에 갔을 때 로빈 씨를 만났어요.",
            "머리가 아팠을 때 이 약을 먹었어요.",
            "방학 때 우리 집에 오세요.",
            "이 사진은 제가 중학생 때 찍은 사진이에요."
          ],
          "rules": [
            "основа без받침 → -ㄹ 때, с받침 → -을 때: 먹다 → 먹을 때",
            "прошедшее (уже случилось однажды) → -았/었을 때",
            "N + 때: 방학 때, 어릴 때"
          ]
        }
      ]
    },
