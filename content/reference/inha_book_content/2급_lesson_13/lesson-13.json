        {
          "id": "grammar-1",
          "toc_section": "준비하기 1",
          "type": "grammar_point",
          "pattern": "AV-고 나면",
          "section": "1",
          "explanation": "**Смысл:** условие, которое наступит после завершения действия — «когда закончу…, то…», «после того как…, то…». Сочетание **-고 나서** и **-(으)면**.",
          "examples": [
            "봄이 지나고 나면 여름이 옵니다.",
            "고민이 있을 때 잠시 쉬고 나면 마음이 편해질 거예요.",
            "이사를 하고 나면 피곤해질 거예요.",
            "비가 그치고 나면 추워질 겁니다."
          ],
          "rules": [
            "основа + **고 나면**"
          ],
          "vocab": [
            {
              "ko": "지나다",
              "translation_ru": "проходить, миновать"
            },
            {
              "ko": "피곤하다",
              "translation_ru": "усталый"
            },
            {
              "ko": "그치다",
              "translation_ru": "прекращаться (о дожде)"
            }
          ]
        },
        {
          "id": "grammar-2",
          "toc_section": "준비하기 1",
          "type": "grammar_point",
          "pattern": "AV-아/어/여야겠다",
          "section": "2",
          "explanation": "**Смысл:** говорящий только что для себя решил, что должен что-то сделать, — твёрдое личное намерение, вывод: «пожалуй, надо…», «придётся…».",
          "examples": [
            "열심히 공부해서 꼭 장학금을 받아야겠습니다.",
            "고향에 가면 제가 좋아하는 음식을 먹어야겠어요.",
            "지난 시험을 못 봐서 이번에는 더 열심히 공부해야겠어요.",
            "가: 늦어서 죄송합니다.",
            "나: 내일은 회의가 있으니까 더 일찍 나오셔야겠습니다."
          ],
          "rules": [
            "основа + **아/어/여야겠다** (гармония гласных как в **-아/어야 되다/하다**)"
          ],
          "vocab": [
            {
              "ko": "장학금",
              "translation_ru": "стипендия"
            },
            {
              "ko": "죄송하다",
              "translation_ru": "виноватый, извиняющийся (вежливая форма)"
            },
            {
              "ko": "회의",
              "translation_ru": "собрание, совещание"
            }
          ]
        }
      ]
    },
