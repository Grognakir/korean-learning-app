          "text_kind": "dialogue",
          "section": "준비하기1",
          "exercise_ref": null,
          "audio_id": "125",
          "speakers": [
            "흐엉",
            "박지성"
          ],
          "lines": [
            {
              "speaker": "흐엉",
              "text": "지성 씨, 요즘 한국의 날씨가 너무 추워요.",
              "emphasized": [
                "추워요"
              ]
            },
            {
              "speaker": "박지성",
              "text": "네, 지금 한국은 겨울이에요. 그래서 날씨가 추워요.",
              "emphasized": [
                "은",
                "추워요"
              ]
            },
            {
              "speaker": "흐엉",
              "text": "제 고향은 항상 더워요.",
              "emphasized": [
                "은",
                "더워요"
              ]
            },
            {
              "speaker": "박지성",
              "text": "그래요? 한국에는 사계절이 있어요."
            },
            {
              "speaker": "흐엉",
              "text": "사계절이요? 사계절의 날씨가 어때요?",
              "emphasized": [
                "어때요"
              ]
            },
            {
              "speaker": "박지성",
              "text": "봄은 따뜻하고 여름은 덥고 가을은 시원하고 겨울은 추워요.",
              "emphasized": [
                "봄은",
                "여름은",
                "가을은",
                "겨울은"
              ]
            },
            {
              "speaker": "흐엉",
              "text": "지성 씨는 무슨 계절을 좋아해요?"
            },
            {
              "speaker": "박지성",
              "text": "저는 가을을 좋아해요. 가을 산이 아주 아름다워요. 그래서 저는 가을에 산에 가서 등산을 해요.",
              "emphasized": [
                "아름다워요",
                "가서"
              ]
            }
          ],
          "vocab": [
            {
              "ko": "추워요",
              "translation_ru": "форма от 춥다 (быть холодным)"
            },
            {
              "ko": "더워요",
              "translation_ru": "форма от 덥다 (быть жарким)"
            },
            {
              "ko": "아름다워요",
              "translation_ru": "форма от 아름답다 (быть красивым)"
            }
          ]
        },
