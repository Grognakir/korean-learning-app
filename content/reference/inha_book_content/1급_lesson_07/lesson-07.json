          "type": "text",
          "title": "날씨와 계절을 표현하기",
          "title_ru": "Говорить о погоде и временах года",
          "illustration": {
            "storage_path": "lesson_7/illustration_1_winter_conversation.png",
            "original_kind": "illustration"
