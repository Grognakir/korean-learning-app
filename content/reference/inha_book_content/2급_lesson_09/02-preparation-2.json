          "lines": [
            {
              "speaker": "간호사",
              "text": "아멜리 씨, 진찰실로 들어가세요."
            },
            {
              "speaker": "아멜리",
              "text": "네."
            },
            {
              "speaker": "의사",
              "text": "아멜리 씨, 어디가 아파서 오셨나요?",
              "emphasized": [
                "나요"
              ]
            },
            {
              "speaker": "아멜리",
              "text": "꽃가루 알레르기가 있어서 그런지 눈이 계속 가렵고 따가워요.",
              "emphasized": [
                "서 그런지"
              ]
            },
            {
              "speaker": "의사",
              "text": "눈을 잠깐 보겠습니다. 언제부터 아팠어요?"
            },
            {
              "speaker": "아멜리",
              "text": "일주일 전부터요. 오늘이 더 심해진 것 같아요."
            },
            {
              "speaker": "의사",
              "text": "좀 심해 보이네요. 한국에 온 지 얼마나 되었어요?",
              "emphasized": [
                "어 보이"
              ]
            },
            {
              "speaker": "아멜리",
              "text": "7개월쯤 됐어요."
            },
            {
              "speaker": "의사",
              "text": "한국에 오기 전에는 괜찮았어요?"
            },
            {
              "speaker": "아멜리",
              "text": "고향에서도 좀 안 좋았어요."
            },
            {
              "speaker": "의사",
              "text": "봄이 되면서 심해진 것 같아요. 박 간호사, 이 환자분 치료실로 모시고 가세요.",
              "emphasized": [
                "면서"
              ]
            }
          ]
        },
        {
