          "title_ru": "Составлять планы на каникулы",
          "illustration": {
            "storage_path": "lesson_8/illustration_2_vacation_plans.png",
            "original_kind": "illustration"
          },
          "text_kind": "dialogue",
          "section": "준비하기2",
          "exercise_ref": null,
          "audio_id": "130",
          "speakers": [
            "아멜리",
            "파하드"
          ],
          "lines": [
            {
              "speaker": "아멜리",
              "text": "파하드 씨, 방학 동안에 뭐 할 거예요?",
              "emphasized": [
                "동안에",
                "할 거예요"
              ]
            },
            {
              "speaker": "파하드",
              "text": "저는 제주도를 여행할 거예요. 제주도를 여행한 후에 부산도 여행할 거예요. 아멜리 씨는요?",
              "emphasized": [
                "여행할 거예요",
                "한 후에",
                "여행할 거예요"
              ]
            },
            {
              "speaker": "아멜리",
              "text": "이번 방학에 제 고향 친구가 한국에 올 거예요. 그래서 저는 친구와 같이 서울과 인천을 구경할 거예요.",
              "emphasized": [
                "올 거예요",
                "구경할 거예요"
              ]
            },
            {
              "speaker": "파하드",
              "text": "아멜리 씨의 친구는 얼마 동안 한국에 있을 거예요?",
              "emphasized": [
                "얼마 동안",
                "있을 거예요"
              ]
            },
            {
              "speaker": "아멜리",
              "text": "제 친구는 한국에 열흘 동안 있을 거예요. 친구가 고향으로 돌아가기 전에 같이 한국 영화를 볼 거예요.",
              "emphasized": [
                "열흘 동안",
                "있을 거예요",
                "돌아가기 전에",
                "볼 거예요"
              ]
            }
          ]
        },
