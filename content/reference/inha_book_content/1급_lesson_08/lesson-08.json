          "lines": [
            {
              "speaker": "왕루",
              "text": "자르갈 씨, 내일 뭐 할 거예요?",
              "emphasized": [
                "할 거예요"
              ]
            },
            {
              "speaker": "자르갈",
              "text": "저는 친구와 함께 영화관에 갈 거예요. 영화를 보고 밥을 먹을 거예요. 왕루 씨는 뭐 할 거예요?",
              "emphasized": [
                "갈 거예요",
                "보고",
                "먹을 거예요",
                "할 거예요"
              ]
            },
            {
              "speaker": "왕루",
              "text": "저는 명동에서 친구를 만날 거예요. 친구를 만나서 쇼핑을 하고 커피숍에 갈 거예요.",
              "emphasized": [
                "만날 거예요",
                "갈 거예요"
              ]
            },
            {
              "speaker": "자르갈",
              "text": "명동에서 뭘 살 거예요?",
              "emphasized": [
                "살 거예요"
              ]
            },
            {
              "speaker": "왕루",
              "text": "모자와 신발을 살 거예요.",
              "emphasized": [
                "살 거예요"
              ]
            }
          ]
        },
