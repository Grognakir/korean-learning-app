      "blocks": [
        {
          "id": "grammar-3",
          "toc_section": "준비하기 2",
          "type": "grammar_point",
          "pattern": "AV-기 전에, N 전에",
          "section": "3",
          "explanation": "«Перед тем как …» / «до N» (за какое-то время до). Время в первой части не ставится.",
          "examples": [
            "1) 밥을 먹기 전에 손을 씻습니다.",
            "2) 학교에 가기 전에 숙제를 할 겁니다.",
            "3) 1시간 전에 일어났습니다."
          ],
          "rules": [
            "V-기 전에 — к основе, 받침 роли не играет: 먹다→먹기 전에, 가다→가기 전에",
            "N 전에: 1시간 전에 («час назад»), 식사 전에 («до еды»)",
            "периоды: N주일 (일주일, 이 주일, 삼 주일), N 달 (한 달, 두 달, 세 달), N 년 (일 년, 이 년, 삼 년)"
          ]
        },
        {
          "type": "reference_table",
          "id": "table-periods",
          "toc_section": "준비하기 2",
          "title": "기간",
          "title_ru": "Периоды времени",
          "columns": [
            "일주일",
            "이 주일",
            "삼 주일",
            "한 달",
            "두 달",
            "세 달",
            "일 년",
            "이 년",
            "삼 년"
          ],
          "translations": [
            "1 неделя",
            "2 недели",
            "3 недели",
            "1 месяц",
            "2 месяца",
            "3 месяца",
            "1 год",
            "2 года",
            "3 года"
          ]
        },
        {
          "id": "grammar-4",
          "toc_section": "준비하기 2",
          "type": "grammar_point",
          "pattern": "AV-(으)ㄴ 후에, N 후에",
          "section": "4",
          "explanation": "«После того как …» / «после N». Прошедшее время завершённого действия.",
          "examples": [
            "1) 밥을 먹은 후에 이를 닦습니다.",
            "2) 요리를 한 후에 밥을 먹었습니다.",
            "3) 샤워 후에 공부를 할 겁니다."
          ],
          "rules": [
            "основа с 받침 → -은 후에: 먹다→먹은 후에",
            "основа без 받침 → -ㄴ 후에: 하다→한 후에, 만나다→만난 후에",
            "основа на ㄹ: ㄹ выпадает → -ㄴ 후에: 만들다→만든 후에",
            "N 후에: 샤워 후에, 식사 후에"
          ]
        },
        {
          "id": "grammar-5",
          "toc_section": "준비하기 2",
          "type": "grammar_point",
          "pattern": "N 동안",
          "section": "5",
          "explanation": "«В течение N», «на протяжении N» — длительность периода.",
          "examples": [
            "1) 가: 몇 시간 동안 점심을 먹어요?\n나: 보통 1시간 동안 점심을 먹어요.",
            "2) 가: 방학 동안 어디에 여행을 갔어요?\n나: 방학 동안 부산에 여행을 갔어요.",
            "3) 가: 얼마 동안 일할 거예요?\n나: 닷새 동안 일할 거예요."
          ],
          "rules": [
            "N 동안 — после слов длительности (1시간, 방학, 얼마, 며칠) и слов, обозначающих период",
            "одна форма, 받침 роли не играет"
          ]
        }
      ]
    },
