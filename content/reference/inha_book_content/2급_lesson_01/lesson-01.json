      "blocks": [
        {
          "id": "text-personal-info-dialogue",
          "toc_section": "준비하기 1",
          "type": "text",
          "title": "개인 정보를 말하기",
          "title_ru": "Рассказать о себе",
          "illustration": {
            "storage_path": "illustration_1_handshake.png",
            "original_kind": "illustration"
          },
          "text_kind": "dialogue",
          "section": "준비하기1",
          "exercise_ref": null,
          "audio_id": "201",
          "speakers": [
            "로빈",
            "아멜리"
          ],
          "lines": [
            {
              "speaker": "로빈",
              "text": "처음 뵙겠습니다. 저는 로빈이라고 합니다.",
              "emphasized": [
                "로빈이라고 합니다"
              ]
            },
            {
              "speaker": "아멜리",
              "text": "안녕하세요? 저는 프랑스에서 온 아멜리라고 해요.",
              "emphasized": [
                "아멜리라고 해요"
              ]
            },
            {
              "speaker": "로빈",
              "text": "네, 만나서 반갑습니다. 저는 영국에서 왔습니다."
            },
            {
              "speaker": "아멜리",
              "text": "로빈 씨는 언제 한국에 왔어요?"
            },
            {
              "speaker": "로빈",
              "text": "저는 한국에 온 지 2년이 됐어요. 아멜리 씨는 한국에 온 지 얼마나 됐어요?",
              "emphasized": [
                "한국에 온 지 2년이 됐어요",
                "한국에 온 지 얼마나 됐어요"
              ]
            },
            {
              "speaker": "아멜리",
              "text": "저는 3개월 전에 왔어요. 지금은 인하대학교에서 한국어를 공부하고 있어요."
            },
            {
              "speaker": "로빈",
              "text": "아, 그래요? 저는 영어를 가르치는 선생님이에요."
            },
            {
              "speaker": "아멜리",
              "text": "반가워요. 앞으로 우리 친하게 지내요."
            }
          ]
        },
        {
          "id": "vocab-junbihagi1",
          "toc_section": "준비하기 1",
          "type": "vocab_list",
          "title": "단어",
          "title_ru": "Слова",
