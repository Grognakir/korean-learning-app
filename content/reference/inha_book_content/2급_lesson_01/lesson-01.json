    {
      "page_number": 11,
      "page_role": "content",
      "source_photo": "photo_7",
      "blocks": [
        {
          "id": "grammar-1",
          "toc_section": "준비하기 1",
          "type": "grammar_point",
          "pattern": "N(이)라고 하다",
          "section": "1",
          "explanation": "Говорим, как что-то или кого-то называют, или пересказываем чужие слова, если в конце существительное — в отличие от N입니다, это не утверждение от себя, а название или чужая речь.",
          "examples": [
            "제 이름은 박지성이라고 합니다.",
            "저는 프랑스에서 온 아멜리라고 합니다."
          ],
          "rules": [
            "после гласной — N라고 하다: 디마라고 해요",
            "после받침 — N이라고 하다: 학생이라고 해요",
            "пересказ уже сказанного — 했어요: 리나 씨는 학생이라고 했어요"
          ]
        },
        {
          "id": "grammar-2",
          "toc_section": "준비하기 1",
          "type": "grammar_point",
          "pattern": "DV-게",
          "section": "2",
          "explanation": "Превращает прилагательное в наречие, отвечающее на вопрос «как?» — ставится перед глаголом, к которому относится.",
          "examples": [
            "선생님께서 이 문법을 쉽게 설명해 주셨습니다.",
            "추우니까 옷을 따뜻하게 입으세요.",
            "맛있게 드세요.",
            "가: 손님, 커피를 어떻게 만들어 드릴까요?\n나: 차갑게 만들어 주세요."
          ],
          "rules": [
            "основа прилагательного (без 다) + 게,받침 значения не имеет: 예쁘다 → 예쁘게, 쉽다 → 쉽게",
            "неправильные ㅂ-прилагательные перед 게 НЕ меняются: 쉽다 → 쉽게 (не 쉬우게)"
          ]
        },
        {
          "id": "grammar-3",
          "toc_section": "준비하기 1",
          "type": "grammar_point",
          "pattern": "AV-(으)ㄴ 지",
          "section": "3",
          "explanation": "Показывает, сколько времени прошло с момента начала действия или состояния.",
          "examples": [
            "가: 파하드 씨는 한국에 온 지 얼마나 됐어요?\n나: 저는 한국에 온 지 1년이 됐어요.",
            "가: 한국에서 산 지 얼마나 됐어요?\n나: 한국에서 산 지 3개월이 지났어요.",
            "가: 공부한 지 몇 시간이 지났어요?\n나: 공부한 지 2시간이 됐어요."
          ],
          "rules": [
            "основа + (으)ㄴ 지 + отрезок времени + 됐어요/지났어요",
            "после гласной или ㄹ받침 (ㄹ выпадает) — просто ㄴ 지: 살다→산 지",
            "после остальных받침 — 은 지: 먹다→먹은 지"
          ]
        }
      ]
    },
