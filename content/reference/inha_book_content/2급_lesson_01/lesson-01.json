      "blocks": [
        {
          "id": "text-classroom-intro",
          "toc_section": "준비하기 2",
          "type": "text",
          "title": "교실에서 자기소개를 하기",
          "title_ru": "Представиться в классе",
          "illustration": {
            "storage_path": "illustration_2_classroom_intro.png",
            "original_kind": "illustration"
          },
          "text_kind": "passage",
          "section": "준비하기2",
          "exercise_ref": null,
          "audio_id": "202",
          "speakers": [
            "흐엉"
          ],
          "lines": [
            {
              "speaker": "흐엉",
              "text": "안녕하십니까? 처음 뵙겠습니다."
            },
            {
              "speaker": "흐엉",
              "text": "저는 베트남에서 온 흐엉이라고 합니다."
            },
            {
              "speaker": "흐엉",
              "text": "저는 한국에 온 지 6개월이 되었습니다. 한국의 드라마와 음악이 좋아서 한국에 왔습니다."
            },
            {
              "speaker": "흐엉",
              "text": "그런데 한국에 와서 한국어도 공부하고 한국 사람들도 만난 후에 한국 문화에 관심이 생겼습니다."
            },
            {
              "speaker": "흐엉",
              "text": "그래서 지금은 한국의 대학교에서 한국학을 전공하려고 한국어를 공부하고 있습니다.",
              "emphasized": [
                "한국학을 전공하려고"
              ]
            },
            {
              "speaker": "흐엉",
              "text": "한국학을 공부를 한 후에는 고향으로 돌아가서 한국에 대해 소개하는 책을 쓰고 싶습니다.",
              "emphasized": [
                "한국에 대해 소개하는"
              ]
            },
