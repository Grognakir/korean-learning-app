          "lines": [
            {
              "speaker": "자르갈",
              "text": "실례합니다. 명동에 어떻게 가요?",
              "emphasized": [
                "어떻게 가요"
              ]
            },
            {
              "speaker": "행인",
              "text": "음, 지금은 길이 많이 막히니까 지하철로 가세요.",
              "emphasized": [
                "지하철로"
              ]
            },
            {
              "speaker": "자르갈",
              "text": "지하철역이 어디에 있어요?"
            },
            {
              "speaker": "행인",
              "text": "여기에서 10번 버스를 타고 가면 주안역이 있어요. 주안역 정류장에서 내려서 지하철 1호선을 타요. 그리고 서울역에서 4호선으로 갈아탄 후에 명동역에서 내려요.",
              "emphasized": [
                "타고 가면",
                "내려서",
                "1호선을 타요",
                "4호선으로 갈아탄 후에",
                "내려요"
              ]
            },
            {
              "speaker": "자르갈",
              "text": "여기에서 명동역까지 얼마나 걸릴까요?",
              "emphasized": [
                "얼마나 걸릴까요"
              ]
            },
            {
              "speaker": "행인",
              "text": "아마 1시간쯤 걸릴 거예요.",
              "emphasized": [
                "1시간쯤 걸릴 거예요"
              ]
            },
            {
              "speaker": "자르갈",
              "text": "아, 정말 감사합니다."
            }
          ]
        },
