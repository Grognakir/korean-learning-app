          "lines": [
            {
              "speaker": "아멜리",
              "text": "안녕하세요? 저는 아멜리입니다. 이름이 무엇입니까?",
              "emphasized": [
                "아멜리입니다",
                "무엇입니까"
              ]
            },
            {
              "speaker": "파하드",
              "text": "제 이름은 파하드입니다. 사우디에서 왔습니다. 아멜리 씨도 사우디 사람입니까?",
              "emphasized": [
                "파하드입니다",
                "사람입니까"
              ]
            },
            {
              "speaker": "아멜리",
              "text": "아니요, 저는 사우디 사람이 아닙니다. 프랑스 사람입니다. 파하드 씨는 선생님입니까?",
              "emphasized": [
                "사람입니다",
                "선생님입니까"
              ]
            },
            {
              "speaker": "파하드",
              "text": "아니요, 저는 선생님이 아닙니다. 학생입니다.",
              "emphasized": [
                "학생입니다"
              ]
            },
            {
              "speaker": "아멜리",
              "text": "저도 학생입니다. 만나서 반갑습니다.",
              "emphasized": [
                "학생입니다"
              ]
            },
            {
              "speaker": "파하드",
              "text": "만나서 반갑습니다."
            }
          ]
        }
      ]
