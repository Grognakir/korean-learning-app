      "blocks": [
        {
          "id": "grammar-4",
          "toc_section": "준비하기 2",
          "type": "grammar_point",
          "pattern": "N이/가 아니다",
          "section": "4",
          "explanation": "Отрицательная форма связки — «это не N». Перед 아니다 существительное оформляется частицей 이/가, а не 을/를.",
          "examples": [
            "가: 왕루 씨는 몽골 사람입니까?\n나: 아니요, 저는 몽골 사람이 아닙니다. 중국 사람입니다.",
            "가: 파하드 씨는 의사입니까?\n나: 아니요, 저는 의사가 아닙니다. 학생입니다."
          ],
          "rules": [
            "N 받침 есть → N이 아니다",
            "N 받침 нет → N가 아니다",
            "перед 아니다 существительное берёт частицу 이/가 (не 은/는)"
          ]
        },
        {
          "id": "grammar-5",
          "toc_section": "준비하기 2",
          "type": "grammar_point",
          "pattern": "N도",
          "section": "5",
          "explanation": "Значит «тоже, также».",
          "examples": [
            "가: 저는 중국 사람입니다.\n나: 저도 중국 사람입니다.",
            "가: 저는 영어 선생님입니다. 로빈 씨도 영어 선생님입니까?\n나: 네, 저도 영어 선생님입니다."
          ],
          "rules": [
            "N도 ставится на том слове, которое получает значение «тоже» — одна форма (받침 роли не играет)",
            "заменяет частицы 은/는, 이/가, 을/를"
          ]
        }
      ]
    },
